# Copia este archivo como .env y rellénalo. El .env NUNCA se sube a git.
# Cuenta de Gmail que ENVÍA los avisos (necesita verificación en 2 pasos)
SMTP_USER=tu_cuenta@gmail.com
# Contraseña de aplicación de 16 letras (sin espacios), NO tu contraseña normal
SMTP_PASS=abcdabcdabcdabcd
# Destinatario de los avisos
EMAIL_TO=destinatario@gmail.com
